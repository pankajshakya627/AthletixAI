# Environment Configuration for AI Fitness Coach
# Copy this file to .env and fill in your values

# OpenAI API Configuration (Required)
OPENAI_API_KEY=your_openai_api_key_here

# Model Configuration (Optional - defaults shown)
OPENAI_VISION_MODEL=gpt-4o
OPENAI_REASONING_MODEL=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o

# Tavily API for Exercise Research (Optional but recommended)
TAVILY_API_KEY=your_tavily_api_key_here

# Supabase Configuration for Long-term Memory (Optional but recommended)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # Anon/public key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # Service role key (optional)

# Persistence Configuration (Optional - fallback to SQLite if Supabase not configured)
DATABASE_URL=sqlite:///./fitness_coach.db

# Logging  Level (Optional)
LOG_LEVEL=INFO
